{
  "name": "cmake-build-model-mcp",
  "version": "0.1.0",
  "description": "MCP server to inspect the build model of CMake projects via the CMake File API",
  "type": "module",
  "bin": {
    "cmake-build-model-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkp124/cmake-build-model-mcp.git"
  },
  "keywords": [
    "mcp",
    "cmake",
    "file-api",
    "build-model",
    "model-context-protocol"
  ],
  "author": "Phani Kiran",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pkp124/cmake-build-model-mcp/issues"
  },
  "homepage": "https://github.com/pkp124/cmake-build-model-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
